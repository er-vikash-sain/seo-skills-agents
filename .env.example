# Search Everywhere OS — Environment Credentials Template
# Copy this file to .env and fill in active keys. DO NOT commit .env to Git.

# Google Search Console API & GA4 API
GSC_CREDENTIALS_JSON_PATH="credentials/gsc_key.json"
GA4_PROPERTY_ID="123456789"

# Google PageSpeed Insights API Key (Free)
PSI_API_KEY="your_pagespeed_api_key_here"

# SERP Data Proxy API (Optional for Volume Data)
DATAFORSEO_API_KEY="your_dataforseo_key_here"

# Model Routing Gateway (Optional)
LLM_GATEWAY_URL="https://api.openai.com/v1"
